{
  "metadata": {
    "description": "Modifier-level evaluation set for testing whether high-PMI compound continuations crowd out plausible minority continuations.",
    "research_question": "When a modifier strongly primes a familiar compound head, does the model still assign reasonable probability to other plausible heads after the same modifier?",
    "construction_protocol": [
      "Use modifiers already represented in the compound-concept experiments where possible.",
      "Pair each modifier with one target compound head and several plausible minority heads.",
      "Keep heads as ordinary single-word continuations so GPT-style next-token probabilities can be compared directly.",
      "Include unrelated heads as a sanity check that minority heads are not merely arbitrary low-probability words."
    ],
    "fields": {
      "target_head": "The head from the compound currently under investigation.",
      "minority_heads": "Alternative plausible one-word continuations after the same modifier.",
      "unrelated_heads": "Implausible controls used to calibrate how much probability mass minority heads receive above unrelated words."
    }
  },
  "prompt_templates": [
    "The {modifier}",
    "A {modifier}",
    "This {modifier}",
    "Their {modifier}",
    "Our {modifier}"
  ],
